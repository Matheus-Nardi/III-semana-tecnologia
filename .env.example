# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — PLATAFORMA SEMANA DE TECNOLOGIA (UNITINS)
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Chave secreta do Payload CMS (gere uma chave longa e aleatória em produção)
PAYLOAD_SECRET=sua-chave-secreta-payload-longa-e-aleatoria-aqui

# Banco de Dados PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=sua-senha-do-banco
POSTGRES_DB=semana_tecnologia
DATABASE_URI=postgresql://app:sua-senha-do-banco@localhost:5432/semana_tecnologia

# Usuário Inicial de Administração (usado no npm run seed)
ADMIN_INITIAL_EMAIL=admin@unitins.br
ADMIN_INITIAL_PASSWORD=testeteste**#

# Armazenamento em Nuvem — Backblaze B2 (compatível com S3)
# (Opcional em desenvolvimento local — se omitido, salva na pasta local media/)
S3_BUCKET=semana-tec-backups
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_ACCESS_KEY_ID=seu-key-id-b2
S3_SECRET_ACCESS_KEY=seu-application-key-b2
S3_REGION=us-east-005

# Certificado SSL / Certbot
CERTBOT_EMAIL=suporte@unitins.br

# Monitoramento e alertas (produção — docker-compose.prod.yml)
# Token do bot do Telegram criado com @BotFather (formato 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=
# ID do chat/canal que receberá os alertas (obtenha via /getUpdates ou @userinfobot)
TELEGRAM_CHAT_ID=
# Chave de autenticação do bouncer CrowdSec (defina uma string alfanumérica longa)
CS_BOUNCER_KEY=troque-por-uma-chave-aleatoria-longa
# Grupo/usuário primário no host (usado pelo CrowdSec; 1000 na maioria das distros)
GID=1000

# Credenciais do painel de métricas (/stats no Nginx)
# Gere o hash assim: openssl passwd -apr1 'SUA_SENHA'
STATS_USER=stats
STATS_HASH=$apr1$exemplo$substituaPeloHashGeradoComOpenssl
