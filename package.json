{
  "name": "semana-tecnologia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "tsx tests/e2e-suite.ts",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:create": "tsx node_modules/payload/dist/bin/index.js migrate:create",
    "generate:importmap": "tsx node_modules/payload/dist/bin/index.js generate:importmap",
    "docker:dev": "docker compose up",
    "docker:dev:build": "docker compose up --build",
    "docker:dev:down": "docker compose down",
    "docker:seed": "docker compose exec nextjs npm run seed",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:backup": "./scripts/backup.sh",
    "docker:restore": "./scripts/restore.sh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "aos": "^3.0.0-beta.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "^15.4.11",
    "payload": "^3.88.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-type-animation": "^3.2.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^15.4.11",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
